---
import { PROJECTS } from '@/consts';
import Project from '@/components/Project.astro';
---

<section>
  <h2>Featured Projects</h2>
  {PROJECTS.map((project, index) => (
    <Project
      index={index + 1}
      projectCount={PROJECTS.length}
      title={project.title}
      description={project.description}
      agency={project.agency}
      roles={project.roles}
      media={project.media}
    />
  ))}
</section>

<style>
  section {
    --projects-top-offset: calc(var(--page-height-basis) * 0.4);
    timeline-scope: --projectView1, --projectView2, --projectView3;
    align-items: start;
    position: relative;
    isolation: isolate;
    grid-template-areas:
      "a a a a b b b b b b b b";

    @media (width < 990px) {
      --projects-top-offset: calc(var(--page-height-basis) * 0.35);
      grid-template-areas:
        "a a a a"
        "b b b b";
    }
  }

  h2 {
    color: var(--color-foreground-dimmed);
    font-size: var(--font-size-heading-sm);
    top: var(--projects-top-offset);
    position: sticky;
    margin-top: var(--projects-top-offset);
    grid-column: 1 / -1;
    grid-row-start: 1;
    z-index: 0;
  }
</style>