---
import IconPlay from '@/assets/icon-play.svg';
import IconPause from '@/assets/icon-pause.svg';
import { videos, type VideoName } from '@/consts';

interface Props {
  video: VideoName;
  preload?: boolean;
}

const { video, preload = false, ...props } = Astro.props;
const { playbackId, thumbnailUrl } = videos[video];
---

<div class="video">
  <video-player
    defaultstreamtype="on-demand"
    nohotkeys
    breakpoints="sm:399 md:768 lg:989 xl:1199"
    autohide="-1"
    autohideovercontrols="false"
    gesturesdisabled
  >
    <mux-video
      playback-id={playbackId}
      slot="media"
      stream-type="on-demand"
      autoplay="muted"
      muted
      loop
      playsinline
      cap-rendition-to-player-size
      preload={preload ? 'auto' : 'none'}
      {...props}
    >
    </mux-video>
    <img
      src={thumbnailUrl}
      slot="poster"
      width="100%"
      height="100%"
      alt=""
      fetchpriority={preload ? 'high' : 'low'}
      loading={preload ? 'eager' : 'lazy'}
    />
    <media-control-bar>
      <media-play-button notooltip>
        <IconPause slot="pause" aria-hidden="true" />
        <IconPlay slot="play" aria-hidden="true" />
      </media-play-button>
    </media-control-bar>
    <svg viewBox="0 0 20 20" width="1rem" height="1rem" fill="none" aria-hidden="true" class="progress-circle">
      <circle cx="10" cy="10" r="10" pathLength="1" stroke="white"/>
    </svg>
  </video-player>
</div>


<style>
  .video {
    --__video-player-button-size: var(--video-player-button-size, clamp(1.25rem, 2vw, 1.5rem));
    --__video-player-border-radius: var(--video-player-border-radius, var(--border-radius-global));
    --__video-player-aspect-ratio: var(--video-player-aspect-ratio, 16 / 9);
    --media-control-background: hsl(0 0 100% / .1);
    --media-control-hover-background: hsl(0 0 100% / .25);
    --media-button-icon-width: calc(var(--__video-player-button-size) * .5);
    --media-button-icon-height: calc(var(--__video-player-button-size) * .5);
    --media-button-padding: 0;
    --media-object-fit: cover;
    --media-poster-image-background-size: cover;
    --media-focus-box-shadow: 0 0 0 2px rgb(27 127 204 / .9);
    --media-background-color: var(--color-background-dimmed);
    --media-control-transition-in: opacity var(--duration-fast) var(--ease-out-quart);
    border-radius: var(--__video-player-border-radius);
    overflow: hidden;
    aspect-ratio: var(--__video-player-aspect-ratio);
    width: 100%;
    height: auto;
    position: relative;
    isolation: isolate;
  }

  @property --video-player-progress {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  video-player {
    display: block;
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;

    @supports (opacity: attr(data-opacity type(<number>))) and at-rule(@property) {
      --video-player-progress: calc(
        1 - (attr(mediacurrenttime type(<number>), 0) / attr(mediaduration type(<number>), 1))
      )
    }
  }

  video-player::part(bottom) {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    align-self: end;
  }

  video-player::part(vertical-layer) {
    mix-blend-mode: exclusion;
  }

  video-player img {
    object-fit: cover;
  }

  media-control-bar {
    opacity: 1 !important;
    position: relative;
    z-index: 1;
  }

  media-play-button {
    border-radius: 100%;
    height: var(--__video-player-button-size);
    width: var(--__video-player-button-size);
    margin: .5rem;
    transition: background var(--duration-fast) var(--ease-out-quart);
    /* box-shadow: 0 0 0 1px var(--media-control-background); */
  }

  media-play-button > *:not(::slotted(*)) {
    display: none;
  }

  media-play-button:hover {
    /* box-shadow: 0 0 0 1px var(--media-control-hover-background); */
  }

  video-player:not([role]) svg {
    display: none;
  }

  .progress-circle {
    opacity: 1 !important;
    overflow: visible;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(var(--__video-player-button-size) - 1px);
    height: calc(var(--__video-player-button-size) - 1px);
    stroke: white;
    stroke-width: .75px;
    pointer-events: none;
    z-index: 0;
  }

  .progress-circle circle {
    transform: rotate(-90deg);
    transform-origin: center;
    stroke-dasharray: var(--video-player-progress, 1) 1;
  }
</style>

<script>
  import '@mux/mux-video';
  import { MediaController } from 'media-chrome';
  import { supportsAttributeFunction } from '@/utils';

  class VideoPlayer extends MediaController {
    constructor() {
      super();
    }

    attributeChangedCallback(name: string, oldValue: string, newValue: string) {
      super.attributeChangedCallback(name, oldValue, newValue);
      if (supportsAttributeFunction()) return;
      if (name !== 'mediacurrenttime' && name !== 'mediaduration') return;
      const current = Number(this.getAttribute('mediacurrenttime'));
      const duration = Number(this.getAttribute('mediaduration'));
      const progress = duration > 0 && Number.isFinite(current) ? current / duration : 0;
      this.style.setProperty('--video-player-progress', String(1 - progress));
    }
  }

  customElements.define('video-player', VideoPlayer);
</script>
