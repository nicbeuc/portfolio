---
import HeaderLink from './HeaderLink.astro';
import AnimatedLogo from './AnimatedLogo.astro';
---

<header>
  <a href="/" class="logo">
    <AnimatedLogo />
  </a>
  <nav>
    <HeaderLink href="#" download>Resumé</HeaderLink>
    <HeaderLink href="mailto:hi@nickbeuchat.com">Contact</HeaderLink>
  </nav>
</header>
<div data-header-threshold></div>

<style>
  header {
    padding-block: var(--page-margin-y);
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 100;
    color: #fff;
    mix-blend-mode: exclusion;
    padding-inline: var(--page-margin-x);
    grid-template-areas:
      "a a a . . . . . b b b b";

    @media (width < 989px) {
      grid-template-areas:
        "a a b b";
    }
  }

  .logo {
    grid-area: a;
    width: fit-content;
  }

  nav {
    grid-area: b;
    justify-self: end;
    display: flex;
    gap: var(--spacing-04);

    @media (width < 989px) {
      gap: var(--spacing-02);
    }
  }

  [data-header-threshold] {
    position: absolute;
    top: 4rem;
    white-space: nowrap;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
</style>