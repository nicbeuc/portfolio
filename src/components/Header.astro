---
import HeaderLink from './HeaderLink.astro';
import AnimatedLogo from './AnimatedLogo.astro';
---

<header>
  <a href="/" class="logo">
    <AnimatedLogo />
  </a>
  <nav>
    <HeaderLink href="#" download>Resumé</HeaderLink>
    <HeaderLink href="mailto:hi@nickbeuchat.com">Contact</HeaderLink>
  </nav>
</header>
<div data-header-threshold></div>

<style>
  header {
    --color-foreground: #fff;
    padding-block: var(--page-margin-y);
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 100;
    color: #fff;
    mix-blend-mode: exclusion;
    padding-inline: var(--page-margin-x);
    grid-template-areas:
      "a a a . . . . . b b b b";

    @media (width < 990px) {
      grid-template-areas:
        "a a b b";
    }
  }

  .logo {
    grid-area: a;
    width: fit-content;
  }

  nav {
    grid-area: b;
    justify-self: end;
    display: flex;
    gap: var(--spacing-04);

    @media (width < 990px) {
      gap: var(--spacing-02);
    }
  }

  [data-header-threshold] {
    position: absolute;
    pointer-events: none;
    top: var(--header-collapse-distance, 4rem);
    white-space: nowrap;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    width: 1px;
    height: 1px;

    /* @supports (timeline-trigger-name: --t) {
      top: 0;
      left: 0;
      right: 0;
      height: 4rem;
      timeline-trigger: --header-threshold-in view() contain / exit, --header-threshold-out view() exit / contain;
      background-color: lightgreen;
      animation-name: triggerDebug1, triggerDebug2;
      animation-duration: .25s;
      animation-fill-mode: forwards;
      animation-timing-function: linear;
      animation-trigger: --header-threshold-in play-forwards, --header-threshold-out play-forwards;
      display: none;
    } */
  }

  @keyframes triggerDebug1 {
    from {
      background-color: lightgreen;
    }
    to {
      background-color: lightblue;
    }
  }

  @keyframes triggerDebug2 {
    from {
      background-color: lightblue;
    }
    to {
      background-color: lightcoral;
    }
  }
</style>