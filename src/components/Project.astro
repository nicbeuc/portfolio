---
import { getProjectImage, type ProjectMedia, type ProjectRole } from '@/consts';
import { Image } from 'astro:assets'
import Video from '@/components/Video.astro';

interface Props {
  title: string;
  index: number;
  projectCount: number;
  description: string;
  agency: string;
  roles: ProjectRole[];
  media: ProjectMedia[];
}

const { title, index, projectCount, description, agency, roles, media } = Astro.props;
---

<project-component
  class="project"
  data-trigger-name={`--projectTrigger${index}`}
  data-trigger-start-point={0.6}
  data-trigger-end-point={index === projectCount ? 0 : 0.2}
>
  <div class="details" data-animation-target>
    <h3>{title}</h3>
    <p>{description}</p>
    <dl>
      <dt>Designed at</dt>
      <dd>{agency}</dd>
      <dt>My roles</dt>
      <dd>
        {roles.map((role, index) => (
          index !== roles.length - 1 ? `${role}, ` : role
        ))}
      </dd>
    </dl>
  </div>
  <div class="media">
    <span data-sentinel="start" aria-hidden="true"></span>
    {media.map((item) => (
      <div class="media-item" data-orientation={item.orientation} data-span={item.span}>
        {item.type === 'image' ? (
          <Image src={getProjectImage(item.name)} alt={title} />
        ) : (
          <Video video={item.name} />
        )}
      </div>
    ))}
    <span data-sentinel="end" aria-hidden="true"></span>
  </div>
</project-component>

<style>
  .project {
    --project-animation-trigger-name: attr(data-trigger-name type(<custom-ident>));
    --project-animation-trigger: var(--project-animation-trigger-name) play-forwards play-backwards;
    --project-animation-trigger-start-point: attr(data-trigger-start-point type(<number>));
    --project-animation-trigger-end-point: attr(data-trigger-end-point type(<number>));
    --project-animation-base-delay: 0ms;
    --project-animation-delay-step: 50ms;
    --project-animation-blur-strength: 4px;
    --project-animation-translate-distance: 10px;
    display: grid;
    position: relative;
    isolation: isolate;
    grid-column: 1 / -1;
    align-items: start;
    grid-template-columns: subgrid;
    z-index: calc(sibling-count() - sibling-index() + 1);
    grid-template-areas:
      "a a a a a b b b b b b b";
    timeline-trigger: var(--project-animation-trigger-name) view() entry calc(var(--project-animation-trigger-start-point) * 100%) exit calc(var(--project-animation-trigger-end-point) * 100%);

    @media (width < 990px) {
      --project-animation-trigger-start-point: 0;
      --project-animation-trigger-end-point: 0.5;
    }

    @media (prefers-reduced-motion: reduce) {
      --project-animation-blur-strength: 0px;
      --project-animation-translate-distance: 0px;
      --project-animation-delay-step: 0ms;
    }
  }

  .project:not(:first-of-type) {
    @media (width < 990px) {
      margin-top: var(--page-height-basis);
    }
  }

  .details {
    grid-area: a;
    position: sticky;
    top: 0;
    display: grid;
    align-items: start;
    grid-template-columns: subgrid;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "c c c c"
      "d d d d"
      "e e e e";
    font-size: var(--font-size-heading-sm);
    height: var(--page-height-basis);
    padding-top: calc(var(--projects-top-offset) + 1lh);
    padding-bottom: var(--page-margin-y);
    /* Help to ensure no shifting occurs when details are scrolled in/out of view. */
    margin-top: calc(var(--page-height-basis) * -3);
    margin-bottom: calc(var(--page-height-basis) * -3);
    z-index: -1;

    @media (width < 990px) {
      grid-template-rows: auto auto auto;
      align-content: start;
      align-items: start;
    }
  }

  .project:first-of-type .details {
    margin-top: calc((var(--projects-top-offset) + 1lh) * -1);
  }

  h3 {
    grid-area: c;
    font-size: var(--font-size-heading-sm);
    margin-bottom: var(--spacing-02);
  }

  p {
    grid-area: d;
    font-size: var(--font-size-body);
    margin-bottom: var(--spacing-04);
    color: var(--color-foreground-dimmed);

    @media (width < 768px) {
      font-size: var(--font-size-body-sm);
    }
  }

  .details > *:last-child {
    --project-details-lastchild-index: calc(sibling-count() - 1);
  }

  dl {
    grid-area: e;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-areas:
      "f f h h"
      "g g i i";
    font-size: var(--font-size-body);

    @media (width < 768px) {
      font-size: var(--font-size-body-sm);
    }
  }

  dt {
    color: var(--color-foreground-dimmed);
  }

  dt:first-of-type {
    grid-area: f;
  }

  dd:first-of-type {
    grid-area: g;
  }

  dt:last-of-type {
    grid-area: h;
  }

  dd:last-of-type {
    grid-area: i;
  }

  h3, p, dt, dd {
    will-change: opacity, filter, transform;
    opacity: 0.001;
    filter: blur(var(--project-animation-blur-strength));
    transform: translate3d(0px, var(--project-animation-translate-distance), 0px);
    animation-duration: var(--duration-medium);
    animation-timing-function: var(--ease-in-out-cubic);
    animation-delay: calc(var(--project-animation-base-delay) + (var(--project-animation-delay-step) * ((var(--project-details-lastchild-index, 0) + sibling-index()) - 1)));
    animation-fill-mode: both;
    animation-name: detailsFadeInUp;

    @media (prefers-reduced-motion: reduce) {
      will-change: opacity;
    }

    @supports (timeline-trigger-name: --t) {
      animation-trigger: var(--project-animation-trigger);
    }

    @supports not (timeline-trigger-name: --t) {
      animation-play-state: paused;
    }
  }

  @keyframes detailsFadeInUp {
    from {
      transform: translate3d(0px, var(--project-animation-translate-distance), 0px);
      opacity: 0.001;
      filter: blur(var(--project-animation-blur-strength));
    }
    to {
      transform: translate3d(0px, 0px, 0px);
      opacity: 1;
      filter: blur(0px);
    }
  }

  .media {
    position: relative;
    grid-area: b;
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-01);
    background-color: var(--color-background);
    margin-bottom: var(--projects-top-offset);
    z-index: 1;

    @media (width < 990px) {
      margin-bottom: 0;
    }
  }

  .project:first-of-type .media {
    @media (width < 990px) {
      margin-top: calc(var(--page-height-basis) - var(--projects-top-offset) - 1lh);
    }
  }

  .project:last-of-type .media {
    margin-bottom: 0;
  }

  [data-sentinel] {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    clip: rect(0, 0, 0, 0);
    /* debug */
    /* width: 100%; */
    /* background-color: red; */
  }

  [data-sentinel="start"] {
    top: 0;
  }

  [data-sentinel="end"] {
    bottom: 0;
  }

  .media-item {
    --video-player-aspect-ratio: 16 / 9;
    grid-column: 1 / -1;
    width: 100%;
    overflow: hidden;

    &[data-orientation="portrait"] {
      --video-player-aspect-ratio: 118 / 135;
    }

    &[data-span="half"] {
      grid-column: span 1;
    }

    &[data-span="full"] {
      grid-column: span 2;
    }
  }

  .media-item[data-orientation="landscape"][data-span="half"] {
    grid-row: span 1;
  }

  .media-item[data-orientation="landscape"][data-span="half"] + .media-item[data-orientation="portrait"][data-span="half"],
  .media-item[data-orientation="portrait"][data-span="half"]:has(+ .media-item[data-orientation="landscape"][data-span="half"]) {
    grid-row: span 2;
  }

  .media-item[data-orientation="landscape"][data-span="half"]:has(+ .media-item[data-orientation="portrait"][data-span="half"]) {
    grid-column-start: 1;
  }

  .media-item[data-orientation="landscape"][data-span="half"] + .media-item[data-orientation="landscape"][data-span="half"] + .media-item[data-orientation="portrait"][data-span="half"] {
    grid-column-start: 2;
  }

  .media-item img,
  .media-item :global(.video) {
    width: 100%;
  }

  .media-item img {
    aspect-ratio: var(--video-player-aspect-ratio);
    height: auto;
    object-fit: cover;
    border-radius: var(--border-radius-global);
  }
</style>

<script>
  import { supportsAnimationTrigger, prefersReducedMotion } from '@/utils';

  class ProjectComponent extends HTMLElement {
    #animations: Animation[] = [];
    #active = false;
    #started = false;
    #ended = false;
    #startObserver: IntersectionObserver | null = null;
    #endObserver: IntersectionObserver | null = null;
    #narrow = window.matchMedia('(width < 990px)');

    connectedCallback() {
      if (supportsAnimationTrigger() || prefersReducedMotion()) return;

      this.#animations = this.getAnimations({ subtree: true })
        .filter((animation: Animation) => animation instanceof CSSAnimation && animation.animationName === 'detailsFadeInUp');

      this.#narrow.addEventListener('change', this.#connect);
      this.#connect();
    }

    disconnectedCallback() {
      this.#narrow.removeEventListener('change', this.#connect);
      this.#disconnectObservers();
    }

    #connect = () => {
      this.#disconnectObservers();

      const start = this.querySelector<HTMLElement>('[data-sentinel="start"]');
      const end = this.querySelector<HTMLElement>('[data-sentinel="end"]');
      if (!start || !end) return;

      this.#started = this.#hasPassed(start, this.#entryLineRatio());
      this.#ended = this.#hasPassed(end, this.#exitLineRatio());
      this.#snap(this.#started && !this.#ended);

      this.#startObserver = this.#observe(start, this.#entryLineRatio(), (passed) => {
        this.#started = passed;
        this.#apply(this.#started && !this.#ended);
      });
      this.#endObserver = this.#observe(end, this.#exitLineRatio(), (passed) => {
        this.#ended = passed;
        this.#apply(this.#started && !this.#ended);
      });
    };

    #disconnectObservers() {
      this.#startObserver?.disconnect();
      this.#endObserver?.disconnect();
      this.#startObserver = null;
      this.#endObserver = null;
    }

    #observe(sentinel: Element, lineFromTop: number, onPass: (passed: boolean) => void) {
      const observer = new IntersectionObserver(([entry]) => {
        onPass(this.#entryHasPassed(entry));
      }, {
        rootMargin: this.#rootMargin(lineFromTop),
        threshold: 0,
      });
      observer.observe(sentinel);
      return observer;
    }

    #entryHasPassed(entry: IntersectionObserverEntry) {
      const root = entry.rootBounds;
      if (!root) return false;
      return entry.isIntersecting || entry.boundingClientRect.top < root.top;
    }

    #apply(active: boolean) {
      if (active === this.#active) return;
      this.#active = active;
      for (const animation of this.#animations) {
        const effect = animation.effect;
        const target = effect instanceof KeyframeEffect ? effect.target : null;
        if (target instanceof HTMLElement) target.style.animationPlayState = 'running';
        animation.playbackRate = active ? 1 : -1;
        animation.play();
      }
    }

    #snap(active: boolean) {
      this.#active = active;
      for (const animation of this.#animations) {
        const end = Number(animation.effect?.getComputedTiming().endTime ?? 0);
        animation.currentTime = active ? end : 0;
        animation.pause();
      }
    }

    #hasPassed(sentinel: Element, lineFromTop: number) {
      const viewport = window.visualViewport;
      const height = viewport?.height ?? window.innerHeight;
      const offset = viewport?.offsetTop ?? 0;
      return sentinel.getBoundingClientRect().top - offset <= height * lineFromTop;
    }

    #entryLineRatio() {
      return 1 - this.#ratio('--project-animation-trigger-start-point', 0.6);
    }

    #exitLineRatio() {
      return 1 - this.#ratio('--project-animation-trigger-end-point', 0.2);
    }

    #ratio(name: string, fallback: number) {
      const value = Number.parseFloat(getComputedStyle(this).getPropertyValue(name));
      return Number.isFinite(value) ? value : fallback;
    }

    #rootMargin(lineFromTop: number) {
      const line = Math.min(Math.max(lineFromTop, 0), 1);
      if (line === 0 || line === 1) return '0px';
      return `-${line * 100}% 0px 0px 0px`;
    }
  }

  customElements.define('project-component', ProjectComponent);
</script>