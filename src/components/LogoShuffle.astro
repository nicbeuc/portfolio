---
import type { SvgComponent } from "astro/types";

const byPath = import.meta.glob<SvgComponent>('../assets/client-logos/*.svg', {
  eager: true,
  import: 'default',
});

const logoGroupPaths = [
  [
    '../assets/client-logos/shakeshack.svg',
    '../assets/client-logos/climbworks.svg',
    '../assets/client-logos/mig.svg',
    '../assets/client-logos/storeease.svg',
  ],
  [
    '../assets/client-logos/ea.svg',
    '../assets/client-logos/enchante.svg',
    '../assets/client-logos/mcnabb.svg',
    '../assets/client-logos/singenuity.svg',
  ],
  [
    '../assets/client-logos/xgames.svg',
    '../assets/client-logos/sofitukker.svg',
    '../assets/client-logos/doingthings.svg',
    '../assets/client-logos/donatelife.svg',
  ],
  [
    '../assets/client-logos/raptv.svg',
    '../assets/client-logos/xul.svg',
    '../assets/client-logos/ambition.svg',
    '../assets/client-logos/teg.svg',
  ],
];

const logoGroups = logoGroupPaths.map((group) => {
  return group.map((path) => {
    const Logo = byPath[path];
    if (!Logo) throw new Error(`Logo not found: ${path}`);
    return Logo;
  });
});
---

<div class="container">
  {logoGroups.map((group, groupIndex) => (
    <div class="group" style={`
      --logo-shuffle-group-index: ${groupIndex};
      --logo-shuffle-group-logo-count: ${group.length};
    `}>
      <div class="group-mask">
        <ul>
          {group.map((Logo) => (
            <li>
              <Logo />
            </li>
          ))}
        </ul>
      </div>
    </div>
  ))}
</div>

<style>

.container {
  display: grid;
  gap: var(--spacing-005);
  grid-template-columns: repeat(4, 1fr);
}

.group {
  --logo-shuffle-duration: 16s;
  --logo-shuffle-blur-amount: 4px;
  --logo-shuffle-stagger: 0.1s;
  --logo-shuffle-radius: 4rem;
  --logo-shuffle-offset: 40%;
  --logo-shuffle-container-height: 4rem;
  --logo-shuffle-container-padding: 1rem;
  --logo-shuffle-container-border-radius: 0.25rem;
  --logo-shuffle-logo-max-height: 2rem;
  --logo-shuffle-logo-max-width: 4rem;
  --logo-shuffle-delay: calc(var(--logo-shuffle-stagger) * var(--logo-shuffle-group-index));
  background-color: var(--color-background-dimmed);
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  border-radius: var(--logo-shuffle-container-border-radius);
  height: var(--logo-shuffle-container-height);
}

.group-mask {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  mask: linear-gradient(to bottom, transparent 0%, black 10% 90%, transparent 100%);
  overflow: hidden;
}

ul {
  position: relative;
  /* height: var(--radius); */
  width: min(var(--logo-shuffle-logo-max-width), calc(100% - var(--logo-shuffle-container-padding) * 2));
  height: min(var(--logo-shuffle-logo-max-height), calc(100% - var(--logo-shuffle-container-padding) * 2));
  perspective: calc(var(--logo-shuffle-container-height) * 1.125);
}

li {
  --logo-shuffle-logo-phase-1-top: 0;
  --logo-shuffle-logo-phase-2-top: var(--logo-shuffle-offset);
  --logo-shuffle-logo-phase-3-top: 0;
  --logo-shuffle-logo-phase-4-top: calc(var(--logo-shuffle-offset) * -1);
  --logo-shuffle-logo-phase-5-top: 0;
  --logo-shuffle-logo-phase-1-transform: rotateX(0deg) translateY(0);
  --logo-shuffle-logo-phase-2-transform: rotateX(90deg) translateY(var(--logo-shuffle-radius));
  --logo-shuffle-logo-phase-3-transform: rotateX(180deg) translateY(0);
  --logo-shuffle-logo-phase-4-transform: rotateX(270deg) translateY(calc(var(--logo-shuffle-radius) * -1));
  --logo-shuffle-logo-phase-5-transform: rotateX(360deg) translateY(0);
  --logo-shuffle-logo-phase-1-filter: blur(0);
  --logo-shuffle-logo-phase-2-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-3-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-4-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-5-filter: blur(0);
  --logo-shuffle-logo-phase-1-opacity: 1;
  --logo-shuffle-logo-phase-2-opacity: 0;
  --logo-shuffle-logo-phase-3-opacity: 0;
  --logo-shuffle-logo-phase-4-opacity: 0;
  --logo-shuffle-logo-phase-5-opacity: 1;
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  opacity: var(--logo-shuffle-logo-phase-1-opacity);
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  backface-visibility: hidden;
  animation-name: rotate4;
  animation-duration: var(--logo-shuffle-duration);
  animation-timing-function: var(--ease-out-quart);
  animation-iteration-count: infinite;
  animation-delay: var(--logo-shuffle-delay);
}

@media (prefers-reduced-motion: no-preference) {
  li {
    will-change: top, transform, filter, opacity;
    top: var(--logo-shuffle-logo-phase-1-top);
    transform: var(--logo-shuffle-logo-phase-1-transform);
    filter: var(--logo-shuffle-logo-phase-1-filter);
  }
}

svg {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

li:nth-child(2) {
  --logo-shuffle-logo-phase-1-top: calc(var(--logo-shuffle-offset) * -1);
  --logo-shuffle-logo-phase-2-top: 0;
  --logo-shuffle-logo-phase-3-top: var(--logo-shuffle-offset);
  --logo-shuffle-logo-phase-4-top: 0;
  --logo-shuffle-logo-phase-5-top: calc(var(--logo-shuffle-offset) * -1);
  --logo-shuffle-logo-phase-1-transform: rotateX(270deg) translateY(calc(var(--logo-shuffle-radius) * -1));
  --logo-shuffle-logo-phase-2-transform: rotateX(360deg) translateY(0);
  --logo-shuffle-logo-phase-3-transform: rotateX(450deg) translateY(var(--logo-shuffle-radius));
  --logo-shuffle-logo-phase-4-transform: rotateX(540deg) translateY(0);
  --logo-shuffle-logo-phase-5-transform: rotateX(630deg) translateY(calc(var(--logo-shuffle-radius) * -1));
  --logo-shuffle-logo-phase-1-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-2-filter: blur(0);
  --logo-shuffle-logo-phase-3-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-4-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-5-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-1-opacity: 0;
  --logo-shuffle-logo-phase-2-opacity: 1;
  --logo-shuffle-logo-phase-3-opacity: 0;
  --logo-shuffle-logo-phase-4-opacity: 0;
  --logo-shuffle-logo-phase-5-opacity: 0;
}

li:nth-child(3) {
  --logo-shuffle-logo-phase-1-top: 0;
  --logo-shuffle-logo-phase-2-top: calc(var(--logo-shuffle-offset) * -1);
  --logo-shuffle-logo-phase-3-top: 0;
  --logo-shuffle-logo-phase-4-top: var(--logo-shuffle-offset);
  --logo-shuffle-logo-phase-5-top: 0;
  --logo-shuffle-logo-phase-1-transform: rotateX(180deg) translateY(0);
  --logo-shuffle-logo-phase-2-transform: rotateX(270deg) translateY(calc(var(--logo-shuffle-radius) * -1));
  --logo-shuffle-logo-phase-3-transform: rotateX(360deg) translateY(0);
  --logo-shuffle-logo-phase-4-transform: rotateX(450deg) translateY(var(--logo-shuffle-radius));
  --logo-shuffle-logo-phase-5-transform: rotateX(540deg) translateY(0);
  --logo-shuffle-logo-phase-1-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-2-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-3-filter: blur(0);
  --logo-shuffle-logo-phase-4-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-5-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-1-opacity: 0;
  --logo-shuffle-logo-phase-2-opacity: 0;
  --logo-shuffle-logo-phase-3-opacity: 1;
  --logo-shuffle-logo-phase-4-opacity: 0;
  --logo-shuffle-logo-phase-5-opacity: 0;
}

li:nth-child(4) {
  --logo-shuffle-logo-phase-1-top: var(--logo-shuffle-offset);
  --logo-shuffle-logo-phase-2-top: 0;
  --logo-shuffle-logo-phase-3-top: calc(var(--logo-shuffle-offset) * -1);
  --logo-shuffle-logo-phase-4-top: 0;
  --logo-shuffle-logo-phase-5-top: var(--logo-shuffle-offset);
  --logo-shuffle-logo-phase-1-transform: rotateX(90deg) translateY(var(--logo-shuffle-radius));
  --logo-shuffle-logo-phase-2-transform: rotateX(180deg) translateY(0);
  --logo-shuffle-logo-phase-3-transform: rotateX(270deg) translateY(calc(var(--logo-shuffle-radius) * -1));
  --logo-shuffle-logo-phase-4-transform: rotateX(360deg) translateY(0);
  --logo-shuffle-logo-phase-5-transform: rotateX(450deg) translateY(var(--logo-shuffle-radius));
  --logo-shuffle-logo-phase-1-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-2-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-3-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-4-filter: blur(0);
  --logo-shuffle-logo-phase-5-filter: blur(var(--logo-shuffle-blur-amount));
  --logo-shuffle-logo-phase-1-opacity: 0;
  --logo-shuffle-logo-phase-2-opacity: 0;
  --logo-shuffle-logo-phase-3-opacity: 0;
  --logo-shuffle-logo-phase-4-opacity: 1;
  --logo-shuffle-logo-phase-5-opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  li {
    animation-name: rotate4ReducedMotion;
  }
}

@keyframes rotate4 {
  0%, 20% {
    top: var(--logo-shuffle-logo-phase-1-top);
    transform: var(--logo-shuffle-logo-phase-1-transform);
    filter: var(--logo-shuffle-logo-phase-1-filter);
    opacity: var(--logo-shuffle-logo-phase-1-opacity);
  }
  25%, 45% {
    top: var(--logo-shuffle-logo-phase-2-top);
    transform: var(--logo-shuffle-logo-phase-2-transform);
    filter: var(--logo-shuffle-logo-phase-2-filter);
    opacity: var(--logo-shuffle-logo-phase-2-opacity);
  }
  50%, 70% {
    top: var(--logo-shuffle-logo-phase-3-top);
    transform: var(--logo-shuffle-logo-phase-3-transform);
    filter: var(--logo-shuffle-logo-phase-3-filter);
    opacity: var(--logo-shuffle-logo-phase-3-opacity);
  }
  75%, 95% {
    top: var(--logo-shuffle-logo-phase-4-top);
    transform: var(--logo-shuffle-logo-phase-4-transform);
    filter: var(--logo-shuffle-logo-phase-4-filter);
    opacity: var(--logo-shuffle-logo-phase-4-opacity);
  }
  100% {
    top: var(--logo-shuffle-logo-phase-5-top);
    transform: var(--logo-shuffle-logo-phase-5-transform);
    filter: var(--logo-shuffle-logo-phase-5-filter);
    opacity: var(--logo-shuffle-logo-phase-5-opacity);
  }
}

@keyframes rotate4ReducedMotion {
  0%, 20% {
    opacity: var(--logo-shuffle-logo-phase-1-opacity);
  }
  25%, 45% {
    opacity: var(--logo-shuffle-logo-phase-2-opacity);
  }
  50%, 70% {
    opacity: var(--logo-shuffle-logo-phase-3-opacity);
  }
  75%, 95% {
    opacity: var(--logo-shuffle-logo-phase-4-opacity);
  }
  100% {
    opacity: var(--logo-shuffle-logo-phase-5-opacity);
  }
}
</style>