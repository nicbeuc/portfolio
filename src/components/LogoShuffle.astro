---
import type { SvgComponent } from "astro/types";

const byPath = import.meta.glob<SvgComponent>('../assets/client-logos/*.svg', {
  eager: true,
  import: 'default',
});

const group1Paths = [
  '../assets/client-logos/shakeshack.svg',
  '../assets/client-logos/climbworks.svg',
  '../assets/client-logos/mig.svg',
  '../assets/client-logos/storeease.svg',
];

const group2Paths = [
  '../assets/client-logos/ea.svg',
  '../assets/client-logos/enchante.svg',
  '../assets/client-logos/mcnabb.svg',
  '../assets/client-logos/singenuity.svg',
];

const group3Paths = [
  '../assets/client-logos/xgames.svg',
  '../assets/client-logos/sofitukker.svg',
  '../assets/client-logos/doingthings.svg',
  '../assets/client-logos/donatelife.svg',
];

const group4Paths = [
  '../assets/client-logos/raptv.svg',
  '../assets/client-logos/xul.svg',
  '../assets/client-logos/ambition.svg',
  '../assets/client-logos/teg.svg',
];

const group1logos = group1Paths.map((path) => {
  const Logo = byPath[path];
  if (!Logo) throw new Error(`Logo not found: ${path}`);
  return Logo;
});

const group2logos = group2Paths.map((path) => {
  const Logo = byPath[path];
  if (!Logo) throw new Error(`Logo not found: ${path}`);
  return Logo;
});

const group3logos = group3Paths.map((path) => {
  const Logo = byPath[path];
  if (!Logo) throw new Error(`Logo not found: ${path}`);
  return Logo;
});

const group4logos = group4Paths.map((path) => {
  const Logo = byPath[path];
  if (!Logo) throw new Error(`Logo not found: ${path}`);
  return Logo;
});
---

<div class="container">
  <ul>
    {group1logos.map((Logo) => (
      <li>
        <Logo />
      </li>
    ))}
  </ul>
  <!-- <ul>
    {group2logos.map((Logo) => (
      <li>
        <Logo />
      </li>
    ))}
  </ul>
  <ul>
    {group3logos.map((Logo) => (
      <li>
        <Logo />
      </li>
    ))}
  </ul>
  <ul>
    {group4logos.map((Logo) => (
      <li>
        <Logo />
      </li>
    ))}
  </ul> -->
</div>

<style>
ul {
  --logo-shuffle-duration: 15s;
  --logo-shuffle-num: 4;
  --radius: 3rem;
  position: relative;
  height: var(--radius);
  /* overflow: hidden; */
  perspective: 2000px;
}

li {
  position: absolute;
  left: 0;
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  /* backface-visibility: hidden; */
  animation-duration: var(--logo-shuffle-duration);
  animation-timing-function: var(--ease-out-quart);
  animation-iteration-count: infinite;
}

li:nth-child(1) {
  animation-name: wheel1;
}

li:nth-child(2) {
  animation-name: wheel2;
}

li:nth-child(3) {
  animation-name: wheel3;
}

li:nth-child(4) {
  animation-name: wheel4;
}

@keyframes wheel1 {
  0%, 18% {
    top: 0;
    transform: rotateX(0deg) translateY(0);
    opacity: 1;
  }
  25%, 43% {
    top: 25%;
    transform: rotateX(90deg) translateY(var(--radius));
    opacity: 0;
  }
  50%, 68% {
    top: 0;
    transform: rotateX(180deg) translateY(0);
    opacity: 0;
  }
  75%, 93% {
    top: -25%;
    transform: rotateX(270deg) translateY(calc(var(--radius) * -1));
    opacity: 0;
  }
  100% {
    top: 0;
    transform: rotateX(360deg) translateY(0);
    opacity: 1;
  }
}

@keyframes wheel2 {
  0%, 18% {
    top: -25%;
    transform: rotateX(270deg) translateY(calc(var(--radius) * -1));
    opacity: 0;
  }
  25%, 43% {
    top: 0;
    transform: rotateX(360deg) translateY(0);
    opacity: 1;
  }
  50%, 68% {
    top: 25%;
    transform: rotateX(450deg) translateY(var(--radius));
    opacity: 0;
  }
  75%, 93% {
    top: 0;
    transform: rotateX(540deg) translateY(0);
    opacity: 0;
  }
  100% {
    top: -25%;
    transform: rotateX(630deg) translateY(calc(var(--radius) * -1));
    opacity: 0;
  }
}

@keyframes wheel3 {
  0%, 18% {
    top: 0;
    transform: rotateX(180deg) translateY(0);
    opacity: 0;
  }
  25%, 43% {
    top: -25%;
    transform: rotateX(270deg) translateY(calc(var(--radius) * -1));
    opacity: 0;
  }
  50%, 68% {
    top: 0;
    transform: rotateX(360deg) translateY(0);
    opacity: 1;
  }
  75%, 93% {
    top: 25%;
    transform: rotateX(450deg) translateY(var(--radius));
    opacity: 0;
  }
  100% {
    top: 0;
    transform: rotateX(540deg) translateY(0);
    opacity: 0;
  }
}

@keyframes wheel4 {
  0%, 18% {
    top: 25%;
    transform: rotateX(90deg) translateY(var(--radius));
    opacity: 0;
  }
  25%, 43% {
    top: 0;
    transform: rotateX(180deg) translateY(0);
    opacity: 0;
  }
  50%, 68% {
    top: -25%;
    transform: rotateX(270deg) translateY(calc(var(--radius) * -1));
    opacity: 0;
  }
  75%, 93% {
    top: 0;
    transform: rotateX(360deg) translateY(0);
    opacity: 1;
  }
  100% {
    top: 25%;
    transform: rotateX(450deg) translateY(var(--radius));
    opacity: 0;
  }
}
</style>